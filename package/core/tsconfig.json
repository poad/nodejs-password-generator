{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noEmit": true,
    "isolatedModules": true,
    "declaration": true,
    "sourceMap": true,
    "noImplicitAny": true
  },
  "exclude": ["node_modules", "src/**/*.test.ts", "eslint.config.ts"]
}
